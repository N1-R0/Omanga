# Environment variables for omanga.biz.
#
# Copy to `.env.local` and fill in. This file is a template and is committed;
# `.env*` is otherwise ignored, so no real value belongs in here.
#
# Only NEXT_PUBLIC_ variables reach the browser. Everything else in this file is
# read exclusively in server code and must never be given that prefix — the
# prefix inlines a value into the client bundle at build time.

# ---------------------------------------------------------------------------
# Public
# ---------------------------------------------------------------------------

# Origin used for canonical URLs, Open Graph URLs and the sitemap. Set per
# environment so preview deployments do not emit production canonicals.
# Defaults to https://omanga.biz when unset.
NEXT_PUBLIC_SITE_URL=https://omanga.biz

# ---------------------------------------------------------------------------
# Zoho Mail — enquiry form delivery (server only, secret)
# ---------------------------------------------------------------------------
# Read only in app/api/enquiry/route.ts. All five are required together: with
# any of them missing the endpoint returns 503 and the form shows its failure
# message rather than silently discarding enquiries.

# Two things decide this value. Getting either wrong fails at authentication,
# not at startup, so check both against Zoho Mail → Settings → Mail Accounts,
# which prints the exact server for this account.
#
#   account type    a paid organisation account on a domain address
#                   (you@omanga.biz) uses smtppro. A free or personal account
#                   (you@zohomail.com) uses smtp. omanga.biz is a domain
#                   address, so smtppro is almost certainly correct.
#   datacentre      the suffix follows where the account was created:
#                   .com, .eu, .in, .com.au, .jp, .ca
#
# So: smtppro.zoho.com, or smtppro.zoho.eu for an EU-hosted account.
ZOHO_SMTP_HOST=smtppro.zoho.com

# 465 for implicit TLS. 587 also works and negotiates STARTTLS.
ZOHO_SMTP_PORT=465

# The full Zoho mailbox address, including the domain. Also used as the From
# address: Zoho refuses to relay a From header that is not this mailbox or one
# of its aliases, and returns "Relaying disallowed" when the two differ.
ZOHO_SMTP_USER=

# An application-specific password generated in Zoho, not the account password.
# Zoho requires one when two-factor authentication is enabled.
ZOHO_SMTP_PASSWORD=

# Where enquiries are delivered. May be the same mailbox as ZOHO_SMTP_USER.
ENQUIRY_RECIPIENT=
